options {
    directory "/var/cache/bind";

    // Allow queries from the entire Docker network and local subnets
    recursion yes;
    allow-query { any; };
    allow-recursion { any; };

    // Upstream DNS forwarders (Google & Cloudflare DNS)
    forwarders {
        8.8.8.8;
        1.1.1.1;
    };

    // DNSSEC validation off to avoid issues with custom .local domains
    dnssec-validation no;

    listen-on { any; };
    listen-on-v6 { any; };
};
